# Settings of the server run with cloud services. Copy to comments.env next to the project
# folder (../comments.env), fill in, and run from the project folder:
#   docker compose --env-file ../comments.env up -d --build

DJANGO_SECRET_KEY=
# Host names the site is opened by, comma-separated: the WebSocket checks Origin against them.
DJANGO_ALLOWED_HOSTS=

# Managed MySQL (Oracle MySQL HeatWave); the connection is encrypted (ssl_mode REQUIRED).
DB_HOST=
DB_PORT=3306
DB_NAME=comments
DB_USER=
DB_PASSWORD=

# Object Storage through its S3 API; the bucket must allow anonymous reads of objects.
S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

RABBITMQ_PASSWORD=

# Optional: RABBITMQ_USER (comments), BACKEND_WORKERS (2), HTTP_PORT (80).
# Load tests only, see perf/README.md: CAPTCHA_TEST_ANSWER, RATE_LIMIT_EXEMPT, DB_POOL_REPORT.
