# The fixed test suite: `perf/run.sh suite <label>` runs exactly this after every change,
# so all suite runs of one version are comparable. Do not edit it to make a change look
# better; a real change of the suite raises SUITE_VERSION (also in k6/main.js) and needs a
# new baseline run on the code before the change.
SUITE_VERSION=3
# Main comparison, twice to show the spread: the load profile with VIEWERS open tabs that
# reload on events, at a rate well below the capacity, so the numbers are stable.
LOAD_RATE=4
LOAD_VIEWERS=10
LOAD_DURATION=2m
LOAD_WARMUP=20s
# Uploads only, with enough samples for a stable attach p95.
UPLOAD_RATE=2
UPLOAD_DURATION=90s
UPLOAD_WARMUP=15s
# Capacity: STEP_DURATION per rate, in this order, until the SLO breaks. Listeners without
# tabs: with reloading tabs the p95 depends on reloads colliding with user requests, not on
# throughput, and the capacity would jump between runs.
# The data set is restored once before the first rate, not before each: a reset takes about
# as long as a step, and the few hundred comments a step adds barely change the data.
STEP_RATES="8 16 20 24 28 32 40 48 56 64 80 96 128"
STEP_DURATION=40s
STEP_WARMUP=10s
STEP_VIEWERS=0
