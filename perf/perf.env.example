# Copy to perf/perf.env (not committed) and adjust.
# ssh aliases from ~/.ssh/config: the app server and a separate machine that runs k6.
APP_SSH=oracle-comments
LOAD_SSH=loadtest
# Project directory on the app server, relative to the ssh user's home; the settings are
# in comments.env next to it.
APP_DIR=comments
# How the load machine reaches the app: a private address keeps the traffic inside the
# cloud network. HOST_HEADER must be one of DJANGO_ALLOWED_HOSTS, or the WebSocket Origin
# check refuses the listeners.
BASE_URL=http://10.0.0.122
HOST_HEADER=89.168.107.87
# Data set restored before every run. TOP and TOTAL must match it (ids 1..TOTAL).
SEED_ARGS="--top 10000 --replies 50000 --authors 2000 --seed 42"
TOP=10000
TOTAL=60000
# Latency target for the p95 of all main-phase requests, ms.
SLO_P95=500
