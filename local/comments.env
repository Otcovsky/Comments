# Settings of the local run (docker-compose.local.yml). Every value here is for containers on
# this machine only and is public in the repository: never use them on a server.
# The server's own file is ../comments.env, made from comments.env.example.

# docker-compose.yml takes the containers' settings from this file instead of ../comments.env.
COMMENTS_ENV_FILE=local/comments.env
HTTP_PORT=8080

DJANGO_SECRET_KEY=local-only-secret-key-do-not-use-on-a-server
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_HOST=mysql
DB_PORT=3306
DB_NAME=comments
DB_USER=comments
DB_PASSWORD=local-db-password
MYSQL_ROOT_PASSWORD=local-root-password

# The keys must match local/s3.json.
S3_ENDPOINT=http://s3:8333
S3_REGION=us-east-1
S3_BUCKET=comments
S3_ACCESS_KEY=local-access-key
S3_SECRET_KEY=local-secret-key

RABBITMQ_PASSWORD=local-broker-password
